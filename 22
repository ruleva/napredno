class WrongDateException extends Exception{
    WrongDateException(Date d){
        super("Wrong date: "+d.toString());
    }
}
class Event{
    String name;
    String location;
    Date date;

    public Event(Date date) {
        this.date = date;
    }

    public long getTime(){
        return date.getTime();
    }

    public String getName() {
        return name;
    }
    public String getMonthAndDay(){
        DateFormat dateFormat=new SimpleDateFormat("dd.MM");
        return dateFormat.format(date);
    }
    public int getMonth(){
        Calendar c=Calendar.getInstance();
        c.setTime(date);
        return c.get(Calendar.MONTH)+1;
    }
    public int getYear(){
        Calendar c=Calendar.getInstance();
        c.setTime(date);
        return c.get(Calendar.YEAR);
    }
    public Event(String name, String location, Date date) {
        this.name = name;
        this.location = location;
        this.date = date;
    }

    @Override
    public String toString() {
        DateFormat dateFormat=new SimpleDateFormat("dd MMM, yyyy HH:mm");
        return dateFormat.format(date)+" at "+location+", "+name;
    }
}
class EventCalendar{
    Map<String, Set<Event>> dates;
    Map<Integer,Integer> byMonth;
    int year;
    public EventCalendar(int year){
        dates=new TreeMap<>();
        this.year=year;
        byMonth=new TreeMap<>();
        for(int i=1;i<=12;i++)
        {
            byMonth.putIfAbsent(i,0);
        }
    }
    public void addEvent(String name, String location, Date date) throws WrongDateException {
        Event e=new Event(name,location,date);
        if(e.getYear()!=year)
        {
            throw new WrongDateException(date);
        }
        dates.putIfAbsent(e.getMonthAndDay(),new TreeSet<>(Comparator.comparing(Event::getTime).thenComparing(Event::getName)));
        dates.get(e.getMonthAndDay()).add(e);
        byMonth.put(e.getMonth(),byMonth.get(e.getMonth())+1);
//        System.out.println(e.getMonthAndDay());
        //        System.out.println(e.getMonthAndDay());
//        System.out.println(dates);
    }
    public void listEvents(Date date){
        Event ev=new Event(date);
//        System.out.println(ev.getMonthAndDay());
        Set<Event> events=dates.get(ev.getMonthAndDay());
        if(events!=null)
        {
            for(Event e:events){

                System.out.println(e);
            }
        }
        else System.out.println("No events on this day!");
        //System.out.println(dates);
    }
    public void listByMonth(){
        for(int i=1;i<=byMonth.size();i++){
            System.out.println(i+" : "+byMonth.get(i));
        }
    }
}
public class EventCalendarTest {
    public static void main(String[] args) throws ParseException {
        Scanner scanner = new Scanner(System.in);
        int n = scanner.nextInt();
        scanner.nextLine();
        int year = scanner.nextInt();
        scanner.nextLine();
        EventCalendar eventCalendar = new EventCalendar(year);
        DateFormat df = new SimpleDateFormat("dd.MM.yyyy HH:mm");
        for (int i = 0; i < n; ++i) {
            String line = scanner.nextLine();
            String[] parts = line.split(";");
            String name = parts[0];
            String location = parts[1];
            Date date = df.parse(parts[2]);
            try {
                eventCalendar.addEvent(name, location, date);
            } catch (WrongDateException e) {
                System.out.println(e.getMessage());
            }
        }
        Date date = df.parse(scanner.nextLine());
        eventCalendar.listEvents(date);
        eventCalendar.listByMonth();
    }
}

